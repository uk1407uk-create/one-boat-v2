{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "one-boat-customer",
  "main": "worker_customer_hero.js",
  "compatibility_date": "2026-09-16",
  "workers_dev": true,
  "routes": [
    { "pattern": "one-boat-club.jp", "custom_domain": true },
    { "pattern": "www.one-boat-club.jp", "custom_domain": true }
  ],
  "assets": {
    "directory": "./customer-public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  }
}
