{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "one-boat-customer",
  "main": "worker_customer_hero.js",
  "compatibility_date": "2026-09-16",
  "workers_dev": true,
  "routes": [
    { "pattern": "one-boat-club.jp", "custom_domain": true },
    { "pattern": "www.one-boat-club.jp", "custom_domain": true }
  ],
  "assets": {
    "directory": "./customer-public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/",
      "/index.html",
      "/*.html",
      "/login",
      "/login/",
      "/register",
      "/register/",
      "/hero-top.jpg",
      "/top-screen.webp",
      "/assets/home-approved-live.webp",
      "/assets/home-approved-exact.webp"
    ],
    "html_handling": "none",
    "not_found_handling": "none"
  }
}
