{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "one-boat-customer",
  "main": "worker_customer.js",
  "compatibility_date": "2026-09-16",
  "assets": {
    "directory": "./customer-public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  }
}
